# Másold ezt a fájlt .env néven, és töltsd ki az üres értékeket. A .env-et a .gitignore kizárja,
# ezt a sablont nem.
#
# Környezeti változókat csak az upload_testcase.py olvas. Az agent.py egyet sem -- nincs
# szüksége sem API kulcsra, sem .env fájlra, csak a Playwrightra és egy letöltött Chromiumra.


# --- TestCaseLab (az upload_testcase.py-hoz kötelező) ---

# A tenant aldomain, NEM a https://testcaselab.com (az a marketing oldal, nincs rajta API).
# Hagyd így, hacsak nem egy másik tenantba töltesz fel.
TCL_BASE_URL=https://pro1115oktatas.testcaselab.com

# A projekt, amibe a feltöltés megy. Használható alapértelmezés nincs: ha üresen marad, az
# upload_testcase.py leáll, és kilistázza az ezen a tenanton látható projekteket. A kulcsot így
# tudod megkeresni, aztán írd be ide:
#   python upload_testcase.py --list-projects
TCL_PROJECT_KEY=

# TestCaseLab bejelentkezési adatok. A webes API az ezekből felépített Devise session-nel
# (cookie + CSRF token) azonosít, nem bearer tokennel -- lásd lentebb a TESTCASELAB_API_KEY-t.
# A fióknak a TCL_BASE_URL-ben megadott tenanthoz kell tartoznia; egy másik céghez tartozó
# fiók sikeresen bejelentkezik, utána viszont JSON helyett HTML-t kap.
TCL_EMAIL=
TCL_PASSWORD=


# --- Ezeket a repóban semmilyen kód nem olvassa ---
# Mindkettő szerepel az eredeti .env-ben. Egyikre sincs szükség; azért vannak itt felsorolva,
# hogy egy friss .env és a régi összevetésekor ne tűnjön úgy, mintha valami kimaradt volna.

# 401-gyel elutasítva. Ez egy JWT, a TestCaseLab webes API-ja pedig nem fogad el bearer tokent --
# pontosan ezért a TCL_EMAIL és a TCL_PASSWORD a kötelező azonosító helyette.
#TESTCASELAB_API_KEY=

# Maradvány. Az agent.py egy korábbi változata a browser-use könyvtárral és egy Mistral modellel
# hajtotta a böngészőt, amely lépésenként döntött; ezt egyszerű Playwright váltotta fel, és már
# egyáltalán nem hív LLM-et.
#MISTRAL_API_KEY=
